---
import "../styles/global.css"
import Nav from "../components/navbar.astro"
import Head from "../components/head.astro"
import Container from "../components/container.astro"
import Footer from "../components/footer.astro"
import I18nScript from "../components/I18nScript.astro"
---

<html lang="en">
    <Head
        title="About Verpitek — Software Development Studio | Lithuania"
        description="Verpitek is a small software development studio based in Lithuania. We build websites, backend systems, and creative digital projects. Custom websites from just 100 EUR."
        path="/about"
    />
    <body>
        <Nav highlighted="navabout" />
        <Container>
            <h1 data-i18n="about.title">About Verpitek</h1>
            <p data-i18n="about.intro">
                Verpitek is a small software development studio based in Lithuania.
                We build web applications, backend systems, and creative digital projects.
            </p>
        </Container>
        <Container>
            <h2 data-i18n="about.story.title">Our Story</h2>
            <p data-i18n="about.story.text">
                What started as a group of developers making game add-ons grew into a proper
                development studio. We still make game content, but now we also build websites,
                backend services, and custom software for clients.
            </p>
        </Container>
        <Container>
            <h2 data-i18n="about.approach.title">Our Approach</h2>
            <p data-i18n="about.approach.text">
                We believe in shipping working software without unnecessary complexity. We write
                clean, maintainable code and focus on solving real problems rather than chasing trends.
            </p>
        </Container>
        <Container>
            <h2 data-i18n="about.work.title">Work With Us</h2>
            <p data-i18n="about.work.text">
                We take on commissions for website development, backend projects, and technical
                consulting. Whether you need a landing page, an API, or a full-stack application
                — we can help. Custom websites start at just 100 EUR.
            </p>
            <p class="work-cta" data-i18n="about.work.cta">Reach us at info@verpitek.com</p>
        </Container>
        <Footer />
        <I18nScript />
    </body>
</html>

<style>
    .work-cta {
        color: #e1ff00;
        font-weight: 600;
        font-size: 1.1rem;
        margin-top: 1.5rem;
    }
</style>
