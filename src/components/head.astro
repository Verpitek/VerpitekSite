---
export interface Props {
    title?: string;
    description?: string;
    lang?: string;
    ogImage?: string;
    path?: string;
}
const {
    title = "Verpitek — Software Development Studio",
    description = "Verpitek is a software development studio specializing in websites, backend systems, and creative digital experiences. Custom websites and APIs from just 100 EUR.",
    lang = "en",
    ogImage = "/verpitek.svg",
    path = "",
} = Astro.props;
const siteUrl = "https://verpitek.com";
const ldOrganization = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Verpitek",
    "url": siteUrl,
    "logo": siteUrl + "/verpitek.svg",
    "description": description,
    "email": "info@verpitek.com",
    "foundingDate": "2023",
    "address": {
        "@type": "PostalAddress",
        "addressCountry": "LT"
    },
    "sameAs": [
        "https://discord.gg/fyNQNrr7dC"
    ]
});
const ldWebsite = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Verpitek",
    "url": siteUrl,
    "potentialAction": {
        "@type": "SearchAction",
        "target": siteUrl + "/wiki/lunatech#{search_term_string}",
        "query-input": "required name=search_term_string"
    }
});
import { ViewTransitions } from 'astro:transitions';
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#212121" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + path} />
    <meta property="og:site_name" content="Verpitek" />
    <meta property="og:locale" content={lang === "lt" ? "lt_LT" : "en_US"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + ogImage} />

    <link rel="canonical" href={siteUrl + path} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={ldOrganization}></script>
    <script type="application/ld+json" set:html={ldWebsite}></script>

    <link rel="preload" as="image" href="/verpitek.svg" />
    <link rel="icon" type="image/svg+xml" href="/verpitek.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet"
    />

    <ViewTransitions />
</head>
