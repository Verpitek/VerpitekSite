---
---

<div class="hero">
    <h1 class="hero-title" data-i18n="hero.title">Verpitek</h1>
    <p class="hero-subtitle" data-i18n="hero.subtitle">Software development studio specializing in web, backend systems, and creative digital experiences. Affordable commissions from just 100 EUR.</p>
    <div class="hero-actions">
        <a href="#projects" class="hero-button" data-i18n="hero.cta">View Our Work</a>
        <a href="#services" class="hero-button hero-button-alt">Services</a>
    </div>
</div>

<style>
    .hero {
        text-align: center;
        padding: 4rem 2rem;
        margin: 0 auto;
        max-width: 1200px;
    }
    .hero-title {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: #e1ff00;
        text-shadow: 0 0 10px rgba(225, 255, 0, 0.3);
        animation: subtle-pulse 4s ease-in-out infinite;
    }
    .hero-subtitle {
        font-size: 1.5rem;
        margin-bottom: 2rem;
        color: papayawhip;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }
    .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    .hero-button {
        display: inline-block;
        padding: 1rem 2rem;
        background: #aa75ff;
        color: #212121;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s, box-shadow 0.3s;
    }
    .hero-button:hover {
        background: #8a55dd;
        box-shadow: 0 4px 12px rgba(170, 117, 255, 0.4);
    }
    .hero-button-alt {
        background: transparent;
        color: #aa75ff;
        border: 1px solid #aa75ff;
    }
    .hero-button-alt:hover {
        background: rgba(170, 117, 255, 0.1);
        color: #e1ff00;
        border-color: #e1ff00;
        box-shadow: 0 0 15px rgba(225, 255, 0, 0.15);
    }

    @media (max-width: 768px) {
        .hero {
            padding: 2rem 1rem;
        }
        .hero-title {
            font-size: 2.5rem;
        }
        .hero-subtitle {
            font-size: 1.125rem;
            padding: 0 1rem;
        }
        .hero-button {
            padding: 1rem 1.5rem;
            min-height: 44px;
            min-width: 140px;
        }
    }
</style>
